{
  "name": "tag-set",
  "version": "0.1.0",
  "private": true,
  "description": "A local music player with inherited tag playlists and YouTube Music playback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diaarca/tag-set.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build && electron wrapper/desktop/main.mjs",
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "security": "node scripts/check-repository.mjs && npm audit --audit-level=high",
    "test:desktop": "electron tests/navigation.electron.mjs && electron tests/interface.electron.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
